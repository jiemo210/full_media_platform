# 全媒体聚合平台环境变量示例（复制为 .env 后填写）
FMP_DB_ENGINE=mysql
FMP_MYSQL_HOST=127.0.0.1
FMP_MYSQL_PORT=3306
FMP_MYSQL_USER=root
FMP_MYSQL_PASSWORD=
FMP_MYSQL_DB=full_media
FMP_REDIS_URL=

# 请使用强随机字符串（如 openssl rand -base64 32）
FMP_JWT_SECRET=change-me-to-a-strong-random-secret

# AI 服务（OpenAI 兼容接口）
FMP_AI_API_KEY=sk-xxx
FMP_AI_BASE_URL=https://api.deepseek.com
FMP_AI_MODEL=deepseek-chat

# 初始管理员密码（缺省则随机生成并强制改密）
FMP_ADMIN_PASSWORD=
FMP_AUTO_CRAWL=false
